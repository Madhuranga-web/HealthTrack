@model List<Appointment>
@{ViewData["Title"]="Appointments";}<div class="d-flex justify-content-between mb-3"><div><h1 class="page-title">Appointments</h1><p class="page-subtitle">Consultation requests and booking history.</p></div>@if(User.IsInRole("Client")){<a class="btn btn-primary align-self-start" asp-action="Book">Book appointment</a>}</div><div class="panel table-responsive"><table class="table"><thead><tr><th>With</th><th>UTC start</th><th>Duration</th><th>Purpose</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@(User.IsInRole("Client")?a.Trainer.FullName:a.Client.FullName)</td><td>@a.StartsUtc.ToString("dd MMM yyyy HH:mm")</td><td>@a.DurationMinutes min</td><td>@a.Purpose</td><td><span class="badge-soft">@a.Status</span></td><td><div class="d-flex gap-1 flex-wrap">@if(User.IsInRole("Trainer")&&a.Status==AppointmentStatus.Pending){<form asp-action="Decide" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"/><button name="decision" value="Approve" class="btn btn-sm btn-outline-primary">Approve</button><button name="decision" value="Reject" class="btn btn-sm btn-outline-danger">Reject</button></form>}@if(User.IsInRole("Trainer")&&a.Status is AppointmentStatus.Pending or AppointmentStatus.Approved){<a asp-action="Reschedule" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Reschedule</a>}@if(a.Status is AppointmentStatus.Pending or AppointmentStatus.Approved){<form asp-action="Cancel" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-outline-danger">Cancel</button></form>}</div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No bookings yet.</div>}</div>
