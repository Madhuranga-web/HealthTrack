@model AppointmentForm
@{ViewData["Title"]="Reschedule";}<h1 class="page-title">Reschedule appointment</h1><p class="page-subtitle">The updated time is confirmed when saved. Enter UTC.</p><div class="panel" style="max-width:700px"><form method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input asp-for="TrainerId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Start (UTC)</label><input asp-for="StartsUtc" type="datetime-local" class="form-control mb-3"/><label class="form-label">Duration</label><input asp-for="DurationMinutes" type="number" min="15" max="180" class="form-control mb-3"/><label class="form-label">Purpose</label><textarea asp-for="Purpose" class="form-control mb-3"></textarea><button class="btn btn-primary">Save new time</button></form></div>
