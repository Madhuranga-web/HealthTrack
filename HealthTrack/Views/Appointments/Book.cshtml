@model AppointmentForm
@{ViewData["Title"]="Book appointment";}<h1 class="page-title">Book a consultation</h1><p class="page-subtitle">Times are entered and displayed in UTC. Approval is required.</p><div class="panel" style="max-width:700px"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Assigned trainer</label><select asp-for="TrainerId" class="form-select mb-3" required><option value="">Choose trainer</option>@foreach(var t in (List<ApplicationUser>)ViewBag.Trainers){<option value="@t.Id">@t.FullName</option>}</select><label class="form-label">Start (UTC)</label><input asp-for="StartsUtc" type="datetime-local" class="form-control mb-3" required/><label class="form-label">Duration (minutes)</label><input asp-for="DurationMinutes" type="number" min="15" max="180" class="form-control mb-3"/><label class="form-label">Purpose</label><textarea asp-for="Purpose" class="form-control mb-3" maxlength="300" required></textarea><button class="btn btn-primary">Request appointment</button></form></div>
