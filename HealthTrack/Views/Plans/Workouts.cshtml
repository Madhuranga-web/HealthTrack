@model List<WorkoutPlan>
@{ViewData["Title"]="Workout plans";}<div class="d-flex justify-content-between mb-3"><div><h1 class="page-title">Workout plans</h1><p class="page-subtitle">Create and manage client routines.</p></div><a class="btn btn-primary align-self-start" asp-action="Workout">New plan</a></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Plan</th><th>Client</th><th>Exercises</th><th>Created</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Title</td><td>@p.Client.FullName</td><td>@p.Exercises.Count</td><td>@p.CreatedUtc.ToString("dd MMM yyyy")</td><td class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Workout" asp-route-id="@p.Id">Edit</a><form asp-action="DeleteWorkout" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this plan?')">Delete</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No workout plans yet.</div>}</div>
