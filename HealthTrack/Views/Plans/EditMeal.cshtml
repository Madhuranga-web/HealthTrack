@model DietPlanMeal
@{ViewData["Title"]="Edit meal";}<h1 class="page-title">Edit recommended meal</h1><div class="panel" style="max-width:700px"><form method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label class="form-label">Meal name</label><input name="name" value="@Model.Name" required maxlength="100" class="form-control mb-3"/><label class="form-label">Food description</label><input name="foodDescription" value="@Model.FoodDescription" required maxlength="500" class="form-control mb-3"/><label class="form-label">Calorie target</label><input name="calorieTarget" value="@Model.CalorieTarget" type="number" min="1" max="3000" class="form-control mb-3"/><label class="form-label">Protein grams</label><input name="proteinGrams" value="@Model.ProteinGrams" type="number" step="0.1" min="0" max="200" class="form-control mb-3"/><label class="form-label">Scheduled time</label><input name="scheduledTime" value="@Model.ScheduledTime.ToString("HH:mm")" type="time" class="form-control mb-3"/><button class="btn btn-primary">Save meal</button></form></div>
