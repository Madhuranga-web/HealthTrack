@model WorkoutExercise
@{ViewData["Title"]="Edit exercise";}<h1 class="page-title">Edit exercise</h1><div class="panel" style="max-width:700px"><form method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label class="form-label">Exercise</label><input name="name" value="@Model.Name" required maxlength="120" class="form-control mb-3"/><label class="form-label">Sets</label><input name="sets" value="@Model.Sets" type="number" min="1" max="30" class="form-control mb-3"/><label class="form-label">Repetitions</label><input name="repetitions" value="@Model.Repetitions" type="number" min="1" max="200" class="form-control mb-3"/><label class="form-label">Duration minutes</label><input name="durationMinutes" value="@Model.DurationMinutes" type="number" min="0" max="240" class="form-control mb-3"/><button class="btn btn-primary">Save exercise</button></form></div>
