@model PlanForm
@{ViewData["Title"]=Model.Id==0?"Create diet":"Edit diet";}
<h1 class="page-title">@(Model.Id==0?"Create diet plan":"Edit diet plan")</h1><p class="page-subtitle">Set recommended targets; clients record actual meals separately.</p><div class="panel"><form asp-action="Diet" method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Client</label><select asp-for="ClientId" class="form-select" required><option value="">Choose client</option>@foreach(var c in (List<ApplicationUser>)ViewBag.Clients){<option value="@c.Id">@c.FullName</option>}</select></div><div class="col-md-4"><label class="form-label">Title</label><input asp-for="Title" class="form-control"/></div><div class="col-md-4"><label class="form-label">Daily calorie target</label><input asp-for="DailyCalorieTarget" type="number" class="form-control"/></div>@if(Model.Id==0){<div class="col-12"><h6>First recommended meal</h6></div><div class="col-md-3"><label class="form-label">Meal name</label><input asp-for="ItemName" class="form-control"/></div><div class="col-md-5"><label class="form-label">Food description</label><input asp-for="FoodDescription" class="form-control"/></div><div class="col-md-2"><label class="form-label">Calorie target</label><input asp-for="MealCalorieTarget" type="number" class="form-control"/></div><div class="col-md-2"><label class="form-label">Protein g</label><input asp-for="ProteinGrams" type="number" step="0.1" class="form-control"/></div><div class="col-md-3"><label class="form-label">Scheduled time</label><input asp-for="ScheduledTime" type="time" class="form-control"/></div>}<div class="col-12"><button class="btn btn-primary">Save plan</button></div></div></form></div>@if(Model.Id>0){<div class="panel"><h5>Recommended meals</h5><table class="table"><tbody>@foreach(var m in (List<DietPlanMeal>)ViewBag.Meals){<tr><td>@m.ScheduledTime</td><td>@m.Name</td><td>@m.FoodDescription</td><td>@m.CalorieTarget kcal</td><td class="d-flex gap-2"><a asp-action="EditMeal" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Edit</a><form asp-action="DeleteMeal" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@m.Id"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>}</tbody></table><h6 class="mt-4">Add meal</h6><form asp-action="AddMeal" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Id"/><div class="col-md-2"><input name="name" required class="form-control" placeholder="Name"/></div><div class="col-md-3"><input name="foodDescription" required class="form-control" placeholder="Food"/></div><div class="col-md-2"><input name="calorieTarget" required type="number" min="1" max="3000" class="form-control" placeholder="Kcal"/></div><div class="col-md-2"><input name="proteinGrams" required type="number" step="0.1" min="0" max="200" class="form-control" placeholder="Protein g"/></div><div class="col-md-2"><input name="scheduledTime" required type="time" class="form-control"/></div><div class="col-md-1"><button class="btn btn-outline-primary">Add</button></div></form></div>}
