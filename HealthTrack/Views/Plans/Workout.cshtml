@model PlanForm
@{ViewData["Title"]=Model.Id==0?"Create workout":"Edit workout";}
<h1 class="page-title">@(Model.Id==0?"Create workout plan":"Edit workout plan")</h1><p class="page-subtitle">Assign a plan to one of your clients.</p><div class="panel"><form asp-action="Workout" method="post">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Client</label><select asp-for="ClientId" class="form-select" required><option value="">Choose client</option>@foreach(var c in (List<ApplicationUser>)ViewBag.Clients){<option value="@c.Id">@c.FullName</option>}</select></div><div class="col-md-6"><label class="form-label">Title</label><input asp-for="Title" class="form-control" required/></div><div class="col-12"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control"></textarea></div>@if(Model.Id==0){<div class="col-12"><h6>First exercise</h6></div><div class="col-md-5"><label class="form-label">Exercise</label><input asp-for="ItemName" class="form-control"/></div><div class="col-md-2"><label class="form-label">Sets</label><input asp-for="Sets" type="number" class="form-control"/></div><div class="col-md-2"><label class="form-label">Reps</label><input asp-for="Repetitions" type="number" class="form-control"/></div><div class="col-md-3"><label class="form-label">Minutes</label><input asp-for="DurationMinutes" type="number" class="form-control"/></div>}<div class="col-12"><button class="btn btn-primary">Save plan</button></div></div></form></div>@if(Model.Id>0){<div class="panel"><h5>Exercises</h5><table class="table"><tbody>@foreach(var e in (List<WorkoutExercise>)ViewBag.Exercises){<tr><td>@e.Name</td><td>@e.Sets sets × @e.Repetitions reps · @e.DurationMinutes min</td><td class="d-flex gap-2"><a asp-action="EditExercise" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a><form asp-action="DeleteExercise" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>}</tbody></table><h6 class="mt-4">Add exercise</h6><form asp-action="AddExercise" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="planId" value="@Model.Id"/><div class="col-md-4"><input name="name" class="form-control" placeholder="Exercise" required/></div><div class="col-md-2"><input name="sets" type="number" min="1" max="30" class="form-control" placeholder="Sets" required/></div><div class="col-md-2"><input name="repetitions" type="number" min="1" max="200" class="form-control" placeholder="Reps" required/></div><div class="col-md-2"><input name="durationMinutes" type="number" min="0" max="240" class="form-control" placeholder="Minutes" required/></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Add</button></div></form></div>}
