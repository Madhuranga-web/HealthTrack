@model List<DietPlan>
@{ViewData["Title"]="Diet plans";}<div class="d-flex justify-content-between mb-3"><div><h1 class="page-title">Diet plans</h1><p class="page-subtitle">Personalized nutrition targets.</p></div><a class="btn btn-primary align-self-start" asp-action="Diet">New plan</a></div><div class="panel table-responsive"><table class="table"><thead><tr><th>Plan</th><th>Client</th><th>Daily kcal target</th><th>Meals</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Title</td><td>@p.Client.FullName</td><td>@p.DailyCalorieTarget</td><td>@p.Meals.Count</td><td class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Diet" asp-route-id="@p.Id">Edit</a><form asp-action="DeleteDiet" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this plan?')">Delete</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No diet plans yet.</div>}</div>
