@{ViewData["Title"]="Health profile"; var p=(ClientProfile)ViewBag.Profile; var u=(ApplicationUser)ViewBag.User;}<h1 class="page-title">Health profile</h1><p class="page-subtitle">Your personal goals and most recently recorded height.</p><div class="panel" style="max-width:700px"><p><strong>Name:</strong> @u.FullName</p><p><strong>Email:</strong> @u.Email</p><p><strong>Height:</strong> @(p.HeightCm?.ToString("0.0")??"Not recorded") cm</p><form asp-action="Goals" method="post">@Html.AntiForgeryToken()<label class="form-label">Fitness goals</label><textarea name="goals" class="form-control mb-3" maxlength="500" rows="4">@p.Goals</textarea><button class="btn btn-primary">Save goals</button></form></div>
