@model List<WorkoutPlan>
@{ViewData["Title"]="My workouts";}<h1 class="page-title">Workout plans</h1><p class="page-subtitle">Trainer assigned exercises and your completed sessions.</p>@if(!Model.Any()){<div class="panel empty">No workout plan assigned yet.</div>}@foreach(var p in Model){<div class="panel"><div class="d-flex justify-content-between"><div><h5>@p.Title</h5><p class="text-muted">@p.Description · @p.Trainer.FullName</p></div><span class="badge-soft">Assigned plan</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Exercise</th><th>Sets</th><th>Reps</th><th>Minutes</th></tr></thead><tbody>@foreach(var e in p.Exercises){<tr><td>@e.Name</td><td>@e.Sets</td><td>@e.Repetitions</td><td>@e.DurationMinutes</td></tr>}</tbody></table></div><hr/><h6>Log a completed exercise</h6><form asp-action="LogWorkout" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="WorkoutPlanId" value="@p.Id"/><div class="col-md-4"><input name="CompletedExercise" required maxlength="120" class="form-control" placeholder="Exercise completed"/></div><div class="col-md-3"><input name="DurationMinutes" type="number" min="1" max="480" required class="form-control" placeholder="Minutes"/></div><div class="col-md-3"><input name="CaloriesBurned" type="number" min="0" max="5000" required class="form-control" placeholder="Calories burned"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Log</button></div></form></div>}
