@{ViewData["Title"]="Progress"; var metrics=(List<HealthMetric>)ViewBag.Metrics; var workouts=(List<WorkoutLog>)ViewBag.Workouts; var meals=(List<MealLog>)ViewBag.Meals; var months=Enumerable.Range(0,6).Select(i=>DateTime.UtcNow.AddMonths(i-5)).ToArray(); var burned=months.Select(m=>workouts.Where(x=>x.LoggedUtc.Year==m.Year&&x.LoggedUtc.Month==m.Month).Sum(x=>x.CaloriesBurned)).ToArray(); var consumed=months.Select(m=>meals.Where(x=>x.LoggedUtc.Year==m.Year&&x.LoggedUtc.Month==m.Month).Sum(x=>x.CaloriesConsumed)).ToArray();}
<h1 class="page-title">Progress tracking</h1><p class="page-subtitle">Measurements and activity from your own records.</p><div class="row g-4"><div class="col-lg-8"><div class="panel"><h5>Weight and BMI trend</h5>@if(metrics.Any()){<div class="chart-wrap"><canvas id="progress"></canvas></div>}else{<div class="empty">Add a measurement to start your chart.</div>}</div></div><div class="col-lg-4"><div class="panel"><h5>Add measurement</h5><form asp-action="Metric" method="post">@Html.AntiForgeryToken()<label class="form-label">Weight (kg)</label><input name="WeightKg" type="number" step="0.1" min="20" max="500" required class="form-control mb-3"/><label class="form-label">Height (cm)</label><input name="HeightCm" type="number" step="0.1" min="50" max="250" required class="form-control mb-3"/><button class="btn btn-primary">Save measurement</button></form></div></div></div><div class="panel"><h5>Monthly activity</h5>@if(workouts.Any()||meals.Any()){<div class="chart-wrap"><canvas id="monthly"></canvas></div>}else{<div class="empty">Log a workout or meal to see monthly activity.</div>}</div><div class="row g-4"><div class="col-lg-6"><div class="panel"><h5>Workout history</h5>@if(workouts.Any()){<table class="table"><tbody>@foreach(var w in workouts){<tr><td>@w.LoggedUtc.ToString("dd MMM")</td><td>@w.CompletedExercise</td><td>@w.CaloriesBurned kcal</td></tr>}</tbody></table>}else{<div class="empty">No workouts logged.</div>}</div></div><div class="col-lg-6"><div class="panel"><h5>Meal history</h5>@if(meals.Any()){<table class="table"><tbody>@foreach(var x in meals){<tr><td>@x.LoggedUtc.ToString("dd MMM")</td><td>@x.Food</td><td>@x.CaloriesConsumed kcal</td></tr>}</tbody></table>}else{<div class="empty">No meals logged.</div>}</div></div></div><div class="panel"><h5>Today's totals</h5><p>Calories burned: <strong>@workouts.Where(x=>x.LoggedUtc.Date==DateTime.UtcNow.Date).Sum(x=>x.CaloriesBurned)</strong> kcal · Calories consumed: <strong>@meals.Where(x=>x.LoggedUtc.Date==DateTime.UtcNow.Date).Sum(x=>x.CaloriesConsumed)</strong> kcal</p></div>
@section Scripts {@if(workouts.Any()||meals.Any()){<script>new Chart(document.getElementById('monthly'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(months.Select(x=>x.ToString("MMM yy")))),datasets:[{label:'Calories burned',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(burned)),backgroundColor:'#0c8e87'},{label:'Calories consumed',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(consumed)),backgroundColor:'#81be69'}]},options:{responsive:true,maintainAspectRatio:false}});</script>}@if(metrics.Any()){<script>new Chart(document.getElementById('progress'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metrics.Select(x=>x.RecordedUtc.ToString("dd MMM")))),datasets:[{label:'Weight (kg)',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metrics.Select(x=>x.WeightKg))),borderColor:'#0c8e87',tension:.3},{label:'BMI',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metrics.Select(x=>x.Bmi))),borderColor:'#81be69',tension:.3}]},options:{responsive:true,maintainAspectRatio:false}});</script>}}
