@{ViewData["Title"]="Client dashboard"; var m=(HealthMetric?)ViewBag.Metric; var a=(Appointment?)ViewBag.Upcoming;}
<h1 class="page-title">Your health, at a glance</h1><p class="page-subtitle">A clear view of today's fitness journey.</p>@if(ViewBag.Announcement!=null){<div class="alert alert-info">@ViewBag.Announcement</div>}<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><div class="stat-icon">⌁</div><div class="stat-label mt-3">Latest BMI</div><div class="stat-number">@(m?.Bmi.ToString("0.0")??"—")</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-icon">♧</div><div class="stat-label mt-3">Workout plans</div><div class="stat-number">@ViewBag.WorkoutCount</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-icon">◈</div><div class="stat-label mt-3">Diet plans</div><div class="stat-number">@ViewBag.DietCount</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-icon">♢</div><div class="stat-label mt-3">Unread messages</div><div class="stat-number">@ViewBag.Unread</div></div></div></div><div class="row g-4"><div class="col-lg-7"><div class="panel"><h5>Keep moving forward</h5><p class="text-muted">Record a workout or meal, then review your trends.</p><a class="btn btn-primary me-2" asp-action="Workouts">View workouts</a><a class="btn btn-outline-primary" asp-action="Progress">Track progress</a></div></div><div class="col-lg-5"><div class="panel"><h5>Next appointment</h5>@if(a!=null){<p class="mb-1">@a.StartsUtc.ToString("dd MMM yyyy HH:mm") UTC</p><span class="badge-soft">@a.Status</span>}else{<div class="empty">No approved appointment ahead.</div>}<div class="mt-3"><a asp-controller="Appointments" asp-action="Book">Book a consultation →</a></div></div></div></div>
