@model List<DietPlan>
@{ViewData["Title"]="My diet";}<h1 class="page-title">Diet and nutrition</h1><p class="page-subtitle">Trainer recommendations and your recorded meals are separate.</p>@if(!Model.Any()){<div class="panel empty">No diet plan assigned yet.</div>}@foreach(var p in Model){<div class="panel"><div class="d-flex justify-content-between"><h5>@p.Title</h5><span class="badge-soft">Target: @p.DailyCalorieTarget kcal/day</span></div><p class="text-muted">Recommended by @p.Trainer.FullName</p><div class="table-responsive"><table class="table"><thead><tr><th>Time</th><th>Meal</th><th>Recommended food</th><th>Target kcal</th><th>Protein</th></tr></thead><tbody>@foreach(var m in p.Meals){<tr><td>@m.ScheduledTime</td><td>@m.Name</td><td>@m.FoodDescription</td><td>@m.CalorieTarget</td><td>@m.ProteinGrams g</td></tr>}</tbody></table></div></div>}<div class="panel"><h5>Log what you actually ate</h5><form asp-action="LogMeal" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-5"><input name="Food" required maxlength="120" class="form-control" placeholder="Food or meal"/></div><div class="col-md-3"><input name="CaloriesConsumed" type="number" min="0" max="5000" required class="form-control" placeholder="Calories consumed"/></div><div class="col-md-2"><input name="ProteinGrams" type="number" step="0.1" min="0" max="500" required class="form-control" placeholder="Protein g"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Log meal</button></div></form></div>
