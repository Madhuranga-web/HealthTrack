@{ var role=User.IsInRole("Admin")?"Admin":User.IsInRole("Trainer")?"Trainer":User.IsInRole("Client")?"Client":"Guest"; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · HealthTrack</title><link rel="stylesheet" href="~/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css"/></head>
<body><div class="app-shell">
@if(User.Identity?.IsAuthenticated==true){<aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">♥</span> HealthTrack</a><div class="sidebar-caption">@role workspace</div><nav class="nav flex-column gap-1">
<a class="nav-link" asp-controller="@role" asp-action="Index">▦ &nbsp;Dashboard</a>
@if(role=="Admin"){<a class="nav-link" asp-controller="Admin" asp-action="Users">♙ &nbsp;Users</a><a class="nav-link" asp-controller="Admin" asp-action="Assignments">⇄ &nbsp;Assignments</a><a class="nav-link" asp-controller="Admin" asp-action="Appointments">▦ &nbsp;Appointments</a><a class="nav-link" asp-controller="Admin" asp-action="Reports">◫ &nbsp;Reports</a><a class="nav-link" asp-controller="Admin" asp-action="Settings">⚙ &nbsp;Settings</a>}
@if(role=="Trainer"){<a class="nav-link" asp-controller="Trainer" asp-action="Clients">♙ &nbsp;Clients</a><a class="nav-link" asp-controller="Plans" asp-action="Workouts">♧ &nbsp;Workout plans</a><a class="nav-link" asp-controller="Plans" asp-action="Diets">◈ &nbsp;Diet plans</a><a class="nav-link" asp-controller="Appointments" asp-action="Index">▦ &nbsp;Appointments</a><a class="nav-link" asp-controller="Trainer" asp-action="Reports">◫ &nbsp;Reports</a>}
@if(role=="Client"){<a class="nav-link" asp-controller="Client" asp-action="Workouts">♧ &nbsp;Workouts</a><a class="nav-link" asp-controller="Client" asp-action="Diet">◈ &nbsp;Diet</a><a class="nav-link" asp-controller="Client" asp-action="Progress">⌁ &nbsp;Progress</a><a class="nav-link" asp-controller="Appointments" asp-action="Index">▦ &nbsp;Appointments</a><a class="nav-link" asp-controller="Client" asp-action="Profile">♙ &nbsp;Health profile</a>}
<a class="nav-link" asp-controller="Notifications" asp-action="Index">♢ &nbsp;Notifications</a><a class="nav-link" asp-controller="Account" asp-action="Profile">⚙ &nbsp;Account</a></nav><div class="sidebar-bottom">Build healthier habits, one day at a time.</div></aside>}
<div class="main-area"><header class="topbar"><div class="d-flex align-items-center gap-3"><button class="sidebar-toggle btn btn-sm btn-outline-secondary" type="button" onclick="document.body.classList.toggle('nav-open')">☰</button><span class="topbar-label">Personal health & fitness management</span></div><div class="topbar-actions">@if(User.Identity?.IsAuthenticated==true){<span class="user-pill">@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">Sign out</button></form>}else{<a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Get started</a>}</div></header>
<main class="page-content container-fluid">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</main><footer class="footer">HealthTrack · CS6004ES coursework demonstration</footer></div></div><script src="~/js/bootstrap.bundle.min.js"></script><script src="~/js/chart.umd.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
