@model List<Appointment>
@{ViewData["Title"]="Appointments";}<h1 class="page-title">All appointments</h1><p class="page-subtitle">System booking overview.</p><div class="panel table-responsive"><table class="table"><thead><tr><th>Client</th><th>Trainer</th><th>UTC start</th><th>Purpose</th><th>Status</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Client.FullName</td><td>@a.Trainer.FullName</td><td>@a.StartsUtc.ToString("dd MMM yyyy HH:mm")</td><td>@a.Purpose</td><td><span class="badge-soft">@a.Status</span></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No appointments yet.</div>}</div>
