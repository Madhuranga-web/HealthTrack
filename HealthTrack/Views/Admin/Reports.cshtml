@{ViewData["Title"]="Engagement report";}<h1 class="page-title">Engagement report</h1><p class="page-subtitle">Counts from actual database records.</p><div class="row g-3"><div class="col-md-3"><div class="stat-card"><div class="stat-label">Workout logs</div><div class="stat-number">@ViewBag.Workouts</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Meal logs</div><div class="stat-number">@ViewBag.Meals</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Health metrics</div><div class="stat-number">@ViewBag.Metrics</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Pending bookings</div><div class="stat-number">@ViewBag.Pending</div></div></div></div>
<div class="panel mt-4"><h5>Most logged routines</h5>@if(((List<PlanPopularity>)ViewBag.Popular).Any()){<table class="table"><thead><tr><th>Workout plan</th><th>Completed logs</th></tr></thead><tbody>@foreach(var p in (List<PlanPopularity>)ViewBag.Popular){<tr><td>@p.Title</td><td>@p.Count</td></tr>}</tbody></table>}else{<div class="empty">No workout logs yet.</div>}</div>