@{ViewData["Title"]="Add account";}<h1 class="page-title">Add a client or trainer</h1><p class="page-subtitle">Admin accounts are created only through controlled local setup.</p><div class="panel" style="max-width:650px"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Full name</label><input class="form-control mb-3" name="fullName" required maxlength="100"/><label class="form-label">Email</label><input class="form-control mb-3" name="email" type="email" required/><label class="form-label">Role</label><select class="form-select mb-3" name="role"><option value="Client">Client</option><option value="Trainer">Trainer</option></select><label class="form-label">Temporary password</label><input class="form-control mb-4" name="password" type="password" required minlength="10"/><button class="btn btn-primary">Create account</button></form></div>
