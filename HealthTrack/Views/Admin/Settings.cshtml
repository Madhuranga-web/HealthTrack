@{ViewData["Title"]="System settings";}<h1 class="page-title">System settings</h1><p class="page-subtitle">Set a message shown on client and trainer dashboards.</p><div class="panel" style="max-width:700px"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Dashboard message</label><textarea name="message" required maxlength="250" rows="4" class="form-control mb-3">@ViewBag.Message</textarea><button class="btn btn-primary">Save message</button></form></div>
