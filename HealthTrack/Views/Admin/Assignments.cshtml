@model List<TrainerAssignment>
@{ViewData["Title"]="Assignments";}<h1 class="page-title">Trainer assignments</h1><p class="page-subtitle">Only assigned trainers can view a client's records.</p><div class="panel"><h5 class="mb-3">Assign a trainer</h5><form asp-action="Assign" method="post" class="row g-2">@Html.AntiForgeryToken()<div class="col-md-5"><select name="trainerId" class="form-select" required><option value="">Choose trainer</option>@foreach(var t in (IList<ApplicationUser>)ViewBag.Trainers){<option value="@t.Id">@t.FullName</option>}</select></div><div class="col-md-5"><select name="clientId" class="form-select" required><option value="">Choose client</option>@foreach(var c in (IList<ApplicationUser>)ViewBag.Clients){<option value="@c.Id">@c.FullName</option>}</select></div><div class="col-md-2"><button class="btn btn-primary w-100">Assign</button></div></form></div><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Trainer</th><th>Client</th><th>Assigned</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Trainer.FullName</td><td>@a.Client.FullName</td><td>@a.AssignedUtc.ToString("dd MMM yyyy")</td><td><form asp-action="Unassign" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No assignments yet.</div>}</div></div>
