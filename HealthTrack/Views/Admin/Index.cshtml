@{ViewData["Title"]="Admin dashboard";}
<h1 class="page-title">System overview</h1><p class="page-subtitle">Monitor accounts, appointments and activity.</p><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><div class="stat-icon">♙</div><div class="stat-label mt-3">Clients</div><div class="stat-number">@ViewBag.ClientCount.Count</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-icon">♧</div><div class="stat-label mt-3">Trainers</div><div class="stat-number">@ViewBag.TrainerCount.Count</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-icon">▦</div><div class="stat-label mt-3">Appointments</div><div class="stat-number">@ViewBag.AppointmentCount</div></div></div></div><div class="row g-4"><div class="col-lg-7"><div class="panel"><h5>Activity in the last six months</h5><div class="chart-wrap"><canvas id="engagement"></canvas></div></div></div><div class="col-lg-5"><div class="panel"><h5>Recent activity</h5>@if(((List<ActivityLog>)ViewBag.Activity).Any()){<div class="table-responsive"><table class="table"><tbody>@foreach(var a in (List<ActivityLog>)ViewBag.Activity){<tr><td>@a.User.FullName</td><td>@a.Action</td><td>@a.CreatedUtc.ToString("dd MMM")</td></tr>}</tbody></table></div>}else{<div class="empty">No activity yet.</div>}</div></div></div>
@section Scripts {<script>new Chart(document.getElementById('engagement'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Months)),datasets:[{label:'Actions',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Engagement)),backgroundColor:'#0c8e87',borderRadius:7}]},options:{responsive:true,maintainAspectRatio:false}});</script>}
