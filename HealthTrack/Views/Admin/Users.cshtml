@model List<ApplicationUser>
@{ViewData["Title"]="Users";}<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-title">User accounts</h1><p class="page-subtitle mb-0">Manage client and trainer access.</p></div><a class="btn btn-primary" asp-action="Create">Add account</a></div><div class="panel"><form method="get" class="d-flex gap-2 mb-3"><input name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Search name or email"/><button class="btn btn-outline-primary">Search</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td><span class="badge-soft">@(u.IsActive?"Active":"Inactive")</span></td><td><form asp-action="Toggle" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-secondary">@(u.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No accounts found.</div>}</div></div>
