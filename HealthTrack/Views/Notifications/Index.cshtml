@model List<Notification>
@{ViewData["Title"]="Notifications";}<h1 class="page-title">Notifications</h1><p class="page-subtitle">Updates about appointments, plans and feedback.</p><div class="panel">@if(!Model.Any()){<div class="empty">You're all caught up.</div>}@foreach(var n in Model){<div class="d-flex justify-content-between border-bottom py-3"><div><div>@if(!n.IsRead){<span class="badge-soft me-2">New</span>}@n.Message</div><small class="text-muted">@n.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</small></div>@if(!n.IsRead){<form asp-action="Read" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@n.Id"/><button class="btn btn-sm btn-outline-primary">Mark read</button></form>}</div>}</div>
