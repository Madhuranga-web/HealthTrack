@{ViewData["Title"]="Client progress"; var c=(ApplicationUser)ViewBag.Client; var metrics=(List<HealthMetric>)ViewBag.Metrics; var workouts=(List<WorkoutLog>)ViewBag.Workouts; var meals=(List<MealLog>)ViewBag.Meals;}
<h1 class="page-title">@c.FullName</h1><p class="page-subtitle">Client progress and feedback</p><div class="row g-4"><div class="col-lg-7"><div class="panel"><h5>Weight and BMI</h5>@if(metrics.Any()){<div class="chart-wrap"><canvas id="progress"></canvas></div>}else{<div class="empty">No measurements logged.</div>}</div></div><div class="col-lg-5"><div class="panel"><h5>Send feedback</h5><form asp-action="Feedback" method="post">@Html.AntiForgeryToken()<input type="hidden" name="clientId" value="@c.Id"/><textarea name="message" class="form-control mb-3" rows="4" required maxlength="1000" placeholder="Encouragement or plan advice"></textarea><button class="btn btn-primary">Send feedback</button></form></div></div></div><div class="row g-4"><div class="col-lg-6"><div class="panel"><h5>Recent workouts</h5>@if(workouts.Any()){<table class="table"><tbody>@foreach(var w in workouts){<tr><td>@w.CompletedExercise</td><td>@w.DurationMinutes min</td><td>@w.CaloriesBurned kcal</td></tr>}</tbody></table>}else{<div class="empty">No workouts logged.</div>}</div></div><div class="col-lg-6"><div class="panel"><h5>Recent meals</h5>@if(meals.Any()){<table class="table"><tbody>@foreach(var m in meals){<tr><td>@m.Food</td><td>@m.CaloriesConsumed kcal</td></tr>}</tbody></table>}else{<div class="empty">No meals logged.</div>}</div></div></div><div class="panel"><h5>Feedback history</h5>@foreach(var f in (List<TrainerFeedback>)ViewBag.Feedback){<p><span class="text-muted">@f.CreatedUtc.ToString("dd MMM yyyy")</span> — @f.Message</p>}</div>
@section Scripts {@if(metrics.Any()){<script>new Chart(document.getElementById('progress'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metrics.Select(x=>x.RecordedUtc.ToString("dd MMM")))),datasets:[{label:'Weight (kg)',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metrics.Select(x=>x.WeightKg))),borderColor:'#0c8e87',tension:.3},{label:'BMI',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(metrics.Select(x=>x.Bmi))),borderColor:'#81be69',tension:.3}]},options:{responsive:true,maintainAspectRatio:false}});</script>}}
