@{ViewData["Title"]="Trainer dashboard";}<h1 class="page-title">Trainer dashboard</h1><p class="page-subtitle">Guide your clients toward their goals.</p>@if(ViewBag.Announcement!=null){<div class="alert alert-info">@ViewBag.Announcement</div>}<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><div class="stat-icon">♙</div><div class="stat-label mt-3">Assigned clients</div><div class="stat-number">@ViewBag.ClientCount</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-icon">▦</div><div class="stat-label mt-3">Pending appointments</div><div class="stat-number">@ViewBag.Pending</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-icon">♧</div><div class="stat-label mt-3">Workout plans</div><div class="stat-number">@ViewBag.Plans</div></div></div></div><div class="panel"><h5>Quick actions</h5><div class="d-flex gap-2 flex-wrap"><a class="btn btn-primary" asp-controller="Plans" asp-action="Workout">Create workout</a><a class="btn btn-outline-primary" asp-controller="Plans" asp-action="Diet">Create diet plan</a><a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Index">Review bookings</a></div></div>
