@model List<TrainerAssignment>
@{ViewData["Title"]="Clients";}<h1 class="page-title">Assigned clients</h1><p class="page-subtitle">Your client roster and progress.</p><div class="panel table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Assigned</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Client.FullName</td><td>@a.Client.Email</td><td>@a.AssignedUtc.ToString("dd MMM yyyy")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Progress" asp-route-id="@a.ClientId">View progress</a></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No clients assigned yet.</div>}</div>
