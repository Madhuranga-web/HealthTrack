@{ViewData["Title"]="Trainer report";}<h1 class="page-title">Client performance report</h1><p class="page-subtitle">Activity for your assigned clients.</p><div class="row g-3"><div class="col-md-3"><div class="stat-card"><div class="stat-label">Clients</div><div class="stat-number">@ViewBag.Clients</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Workouts</div><div class="stat-number">@ViewBag.Workouts</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Meals</div><div class="stat-number">@ViewBag.Meals</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Measurements</div><div class="stat-number">@ViewBag.Metrics</div></div></div></div><p class="mt-4">Use the <a asp-action="Clients">client roster</a> to review individual trends.</p>
