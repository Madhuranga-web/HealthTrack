@model LoginForm
@{ViewData["Title"]="Sign in";}<div class="panel auth-card"><div class="stat-icon mb-3">♥</div><h1 class="page-title">Welcome back</h1><p class="page-subtitle">Sign in to your HealthTrack account.</p><form method="post" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/></div><div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label"></label></div><button class="btn btn-primary w-100">Sign in</button></form><p class="mt-3 mb-0">New client? <a asp-action="Register">Create an account</a></p></div>
