@model ApplicationUser
@{ViewData["Title"]="Account";}<h1 class="page-title">Account profile</h1><p class="page-subtitle">Update your display name.</p><div class="panel" style="max-width:600px"><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Full name</label><input name="fullName" value="@Model.FullName" maxlength="100" required class="form-control mb-3"/><label class="form-label">Email</label><input value="@Model.Email" disabled class="form-control mb-3"/><button class="btn btn-primary">Save profile</button> <a class="btn btn-outline-primary" asp-action="ChangePassword">Change password</a></form></div>
